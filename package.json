    "@fontsource/inter": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.9",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "webextension-polyfill": "^0.12.0"
